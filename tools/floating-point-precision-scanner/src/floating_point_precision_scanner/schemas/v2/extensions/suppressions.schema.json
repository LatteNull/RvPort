{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rvport.dev/schemas/floating-point-scanner/extensions/suppressions/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyAsOf", "records"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "policyAsOf": {"type": ["string", "null"], "format": "date"},
    "records": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "findingId", "findingCode", "path", "startLine", "endLine", "reason", "reasonEn", "source", "status", "expiresOn"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "findingId": {"type": ["string", "null"]},
        "findingCode": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "startLine": {"type": ["integer", "null"], "minimum": 1},
        "endLine": {"type": ["integer", "null"], "minimum": 1},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
        "reasonEn": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source": {"enum": ["request", "source"]},
        "status": {"enum": ["applied", "expired", "unmatched", "budget_unrecorded", "budgetUnrecorded"]},
        "expiresOn": {"type": ["string", "null"], "format": "date"}
      }
    }
  }
}
