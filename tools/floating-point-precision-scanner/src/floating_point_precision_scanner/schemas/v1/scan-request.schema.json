{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rvport.dev/schemas/floating-point-precision-scanner/v1/scan-request.schema.json",
  "title": "FloatingPointPrecisionScanRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "request_id", "project_root", "source_profile", "target_profile", "input"],
  "properties": {
    "kind": {"const": "FloatingPointPrecisionScanRequest"},
    "schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4"]},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_root": {"type": "string", "minLength": 1},
    "source_profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*@[0-9]+\\.[0-9]+$"},
    "target_profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*@[0-9]+\\.[0-9]+$"},
    "source_revision": {"type": "string", "minLength": 1},
    "policy_as_of": {"type": "string", "format": "date"},
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["off", "read-only", "write-only", "read-write"]},
        "root": {"type": "string", "minLength": 1},
        "max_entry_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "build_contexts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"type": "object"},
        "target": {"type": "object"}
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "reason"],
        "properties": {
          "code": {
            "enum": ["long-double-abi", "x87-excess-precision", "fma-contraction", "unsafe-fp-optimization", "floating-environment", "mixed-precision-conversion", "fragile-fp-comparison", "reduction-reassociation", "math-library-variance", "architecture-specific-fp-api"]
          },
          "path": {"type": "string", "minLength": 1, "not": {"enum": ["*", "**", "**/*"]}},
          "reason": {"type": "string", "minLength": 1},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "expires_on": {"type": "string", "format": "date"}
        }
      }
    },
    "bitcode_artifact_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_root", "manifest", "manifest_sha256"],
      "properties": {
        "artifact_root": {"type": "string", "minLength": 1},
        "manifest": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "required_profiles": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["source-preserving", "build-faithful"]},
          "default": ["source-preserving"]
        },
        "source_mapping": {"enum": ["required", "best-effort"], "default": "best-effort"}
      }
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["compile_commands"],
          "properties": {"compile_commands": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["translation_units"],
          "properties": {
            "translation_units": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "directory", "arguments"],
                "properties": {
                  "file": {"type": "string", "minLength": 1},
                  "directory": {"type": "string", "minLength": 1},
                  "arguments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                  "platform": {"enum": ["posix", "windows"], "default": "posix"}
                }
              }
            }
          }
        }
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "disabled": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
        "versions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}, "properties": {
          "long-double-abi": {"const": "1.0"},
          "x87-excess-precision": {"const": "1.0"},
          "fma-contraction": {"const": "1.0"},
          "unsafe-fp-optimization": {"const": "1.0"},
          "floating-environment": {"const": "1.0"},
          "mixed-precision-conversion": {"const": "1.0"},
          "fragile-fp-comparison": {"const": "1.0"},
          "reduction-reassociation": {"const": "1.0"},
          "math-library-variance": {"const": "1.0"},
          "architecture-specific-fp-api": {"const": "1.0"}
        }}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "cpu_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_memory_bytes": {"type": "integer", "minimum": 1048576},
        "max_files": {"type": "integer", "minimum": 1},
        "max_response_depth": {"type": "integer", "minimum": 0, "maximum": 32},
        "max_response_bytes": {"type": "integer", "minimum": 1},
        "max_ir_facts": {"type": "integer", "minimum": 1},
        "max_ir_output_bytes": {"type": "integer", "minimum": 1},
        "max_frontend_output_bytes": {"type": "integer", "minimum": 1},
        "max_bitcode_bytes": {"type": "integer", "minimum": 1},
        "max_evidence_candidates": {"type": "integer", "minimum": 1},
        "max_rule_assessments": {"type": "integer", "minimum": 1},
        "max_rule_candidates": {"type": "integer", "minimum": 1},
        "max_rule_evidence_refs": {"type": "integer", "minimum": 1},
        "max_related_locations": {"type": "integer", "minimum": 1},
        "max_rule_diagnostics": {"type": "integer", "minimum": 1}
        ,"max_function_summary_depth": {"type": "integer", "minimum": 0}
        ,"max_ir_use_chain": {"type": "integer", "minimum": 1}
        ,"max_ir_summary_call_edges": {"type": "integer", "minimum": 0}
        ,"max_suppression_records": {"type": "integer", "minimum": 1}
        ,"max_result_bytes": {"type": "integer", "minimum": 1}
        ,"max_cache_entry_bytes": {"type": "integer", "minimum": 1}
        ,"max_diagnostics": {"type": "integer", "minimum": 1}
      }
    }
  }
}
