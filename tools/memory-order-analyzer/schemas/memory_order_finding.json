{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rvport.local/memory-order-analyzer/finding-v2.schema.json",
  "$defs": {
    "Id": {"type": "string", "minLength": 1},
    "Hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Status": {"enum": ["complete", "partial", "ambiguous", "unknown"]},
    "Provenance": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "producer", "schemaVersion", "digest"], "properties": {"kind": {"$ref": "#/$defs/Id"}, "id": {"$ref": "#/$defs/Id"}, "producer": {"$ref": "#/$defs/Id"}, "schemaVersion": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/Hash"}}},
    "Position": {"type": "object", "additionalProperties": false, "required": ["line", "column"], "properties": {"line": {"type": "integer", "minimum": 1}, "column": {"type": "integer", "minimum": 1}}},
    "Span": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/Position"}, "end": {"$ref": "#/$defs/Position"}}},
    "Context": {"type": "object", "additionalProperties": false, "required": ["status", "reasonCodes", "lines", "highlights", "budget"], "properties": {"status": {"enum": ["complete", "partial", "unavailable"]}, "reasonCodes": {"type": "array", "items": {"$ref": "#/$defs/Id"}, "uniqueItems": true}, "lines": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["line", "text"], "properties": {"line": {"type": "integer", "minimum": 1}, "text": {"type": "string"}}}}, "highlights": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["line", "startColumn", "endColumn"], "properties": {"line": {"type": "integer", "minimum": 1}, "startColumn": {"type": "integer", "minimum": 1}, "endColumn": {"type": "integer", "minimum": 2}}}}, "budget": {"type": "object", "additionalProperties": false, "required": ["beforeLines", "afterLines", "maxLines", "maxCharacters", "truncated"], "properties": {"beforeLines": {"type": "integer", "minimum": 0}, "afterLines": {"type": "integer", "minimum": 0}, "maxLines": {"type": "integer", "minimum": 1, "maximum": 256}, "maxCharacters": {"type": "integer", "minimum": 1, "maximum": 65536}, "truncated": {"type": "boolean"}}}}},
    "Source": {"type": "object", "additionalProperties": false, "required": ["file", "span", "sourceSha256", "snapshot", "context"], "properties": {"file": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}, "span": {"$ref": "#/$defs/Span"}, "sourceSha256": {"$ref": "#/$defs/Hash"}, "snapshot": {"type": ["object", "null"]}, "context": {"$ref": "#/$defs/Context"}}},
    "Occurrence": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "role", "scopeId", "physicalTuId", "location", "status", "reasonCodes", "provenance"], "properties": {"id": {"$ref": "#/$defs/Id"}, "kind": {"$ref": "#/$defs/Id"}, "role": {"$ref": "#/$defs/Id"}, "scopeId": {"$ref": "#/$defs/Id"}, "physicalTuId": {"type": ["string", "null"]}, "functionId": {"type": ["string", "null"]}, "contextId": {"type": ["string", "null"]}, "threadInstanceId": {"type": ["string", "null"]}, "location": {"oneOf": [{"$ref": "#/$defs/Source"}, {"type": "null"}]}, "status": {"$ref": "#/$defs/Status"}, "reasonCodes": {"type": "array", "items": {"$ref": "#/$defs/Id"}, "uniqueItems": true}, "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Provenance"}}}},
    "Step": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "title", "title_en", "status", "reason", "reason_en", "reasonCodes", "source", "provenance"], "properties": {"id": {"$ref": "#/$defs/Id"}, "kind": {"enum": ["source-fact", "thread-creation", "callback-binding", "execution-root", "call-path", "thread-instance", "mhp", "memory-access", "object-provenance", "byte-range-overlap", "mutex-region", "raii-region", "atomic-event", "reads-from", "modification-order", "release-sequence", "synchronization-proof", "synchronization-gap", "conclusion"]}, "title": {"$ref": "#/$defs/Id"}, "title_en": {"$ref": "#/$defs/Id"}, "status": {"$ref": "#/$defs/Status"}, "reason": {"$ref": "#/$defs/Id"}, "reason_en": {"$ref": "#/$defs/Id"}, "reasonCodes": {"type": "array", "items": {"$ref": "#/$defs/Id"}, "uniqueItems": true}, "source": {"oneOf": [{"$ref": "#/$defs/Source"}, {"type": "null"}]}, "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Provenance"}}, "data": {"type": "object"}}},
    "Edge": {"type": "object", "additionalProperties": false, "required": ["id", "fromStepId", "toStepId", "kind", "status", "reasonCodes", "provenance"], "properties": {"id": {"$ref": "#/$defs/Id"}, "fromStepId": {"$ref": "#/$defs/Id"}, "toStepId": {"$ref": "#/$defs/Id"}, "kind": {"enum": ["creates", "binds", "reaches", "calls", "executes-as", "may-happen-in-parallel", "accesses", "aliases", "overlaps", "protected-by", "communicates-via", "ordered-by", "supports", "supports-candidate", "alternative-to"]}, "status": {"$ref": "#/$defs/Status"}, "reasonCodes": {"type": "array", "items": {"$ref": "#/$defs/Id"}, "uniqueItems": true}, "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Provenance"}}}},
    "Break": {"type": "object", "additionalProperties": false, "required": ["id", "status", "reasonCode", "stage", "candidateStepIds", "detail", "detail_en", "suggestion", "suggestion_en"], "properties": {"id": {"$ref": "#/$defs/Id"}, "status": {"enum": ["partial", "ambiguous", "unknown"]}, "reasonCode": {"$ref": "#/$defs/Id"}, "stage": {"$ref": "#/$defs/Id"}, "fromStepId": {"type": ["string", "null"]}, "candidateStepIds": {"type": "array", "items": {"$ref": "#/$defs/Id"}, "uniqueItems": true}, "expectedKind": {"type": ["string", "null"]}, "missingId": {"type": ["string", "null"]}, "detail": {"$ref": "#/$defs/Id"}, "detail_en": {"$ref": "#/$defs/Id"}, "suggestion": {"$ref": "#/$defs/Id"}, "suggestion_en": {"$ref": "#/$defs/Id"}}},
    "MemoryOrderFindingProjection": {
      "allOf": [
        {"if": {"properties": {"schemaVersion": {"const": "2.0"}}}, "then": {"properties": {"conclusion": {"properties": {"confidence": {"type": "number"}}, "not": {"required": ["evidenceLevel"]}}}}},
        {"if": {"properties": {"schemaVersion": {"const": "3.0"}}}, "then": {"properties": {"conclusion": {"required": ["evidenceLevel"]}}}}
      ],
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "scopeId", "fact", "conclusion", "occurrences", "primaryOccurrenceId", "evidenceChain", "semanticDigest"],
      "properties": {
        "schemaVersion": {"enum": ["2.0", "3.0"]}, "kind": {"const": "MemoryOrderFindingProjection"}, "id": {"$ref": "#/$defs/Id"}, "scopeId": {"$ref": "#/$defs/Id"},
        "fact": {"type": "object", "additionalProperties": false, "required": ["kind", "matchedText", "primaryLocation", "provenance"], "properties": {"kind": {"enum": ["publication-protocol", "concurrent-access", "atomic-communication", "synchronization-gap", "source-candidate"]}, "symbol": {"type": ["string", "null"]}, "matchedText": {"$ref": "#/$defs/Id"}, "primaryLocation": {"oneOf": [{"$ref": "#/$defs/Source"}, {"type": "null"}]}, "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Provenance"}}}},
        "conclusion": {"type": "object", "additionalProperties": false, "required": ["title", "title_en", "severity", "confidence", "findingType", "verdict", "actionable", "blocking", "status", "reason", "reason_en", "suggestion", "suggestion_en", "detail", "detail_en", "assumptions", "limitations"], "properties": {"title": {"$ref": "#/$defs/Id"}, "title_en": {"$ref": "#/$defs/Id"}, "severity": {"enum": ["info", "low", "medium", "high", "critical"]}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "evidenceLevel": {"enum": ["source-only", "incomplete", "bounded-model"]}, "findingType": {"$ref": "#/$defs/Id"}, "verdict": {"enum": ["risk", "source-candidate", "discharged-within-bounded-model", "inconclusive"]}, "actionable": {"type": "boolean"}, "blocking": {"type": "boolean"}, "status": {"$ref": "#/$defs/Status"}, "reason": {"$ref": "#/$defs/Id"}, "reason_en": {"$ref": "#/$defs/Id"}, "suggestion": {"$ref": "#/$defs/Id"}, "suggestion_en": {"$ref": "#/$defs/Id"}, "detail": {"$ref": "#/$defs/Id"}, "detail_en": {"$ref": "#/$defs/Id"}, "assumptions": {"type": "array", "items": {"$ref": "#/$defs/Id"}}, "limitations": {"type": "array", "items": {"$ref": "#/$defs/Id"}}}},
        "occurrences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Occurrence"}}, "primaryOccurrenceId": {"$ref": "#/$defs/Id"},
        "evidenceChain": {"type": "object", "additionalProperties": false, "required": ["status", "reasonCodes", "rootStepId", "primaryPath", "steps", "edges", "breaks", "impactStepIds", "budget"], "properties": {"status": {"$ref": "#/$defs/Status"}, "reasonCodes": {"type": "array", "items": {"$ref": "#/$defs/Id"}, "uniqueItems": true}, "rootStepId": {"$ref": "#/$defs/Id"}, "primaryPath": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Id"}, "uniqueItems": true}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Step"}}, "edges": {"type": "array", "items": {"$ref": "#/$defs/Edge"}}, "breaks": {"type": "array", "items": {"$ref": "#/$defs/Break"}}, "impactStepIds": {"type": "array", "items": {"$ref": "#/$defs/Id"}, "uniqueItems": true}, "budget": {"type": "object", "additionalProperties": false, "required": ["maxDepth", "maxVisited", "maxPaths", "visited", "paths", "truncated"], "properties": {"maxDepth": {"type": "integer", "minimum": 1}, "maxVisited": {"type": "integer", "minimum": 1}, "maxPaths": {"type": "integer", "minimum": 1}, "visited": {"type": "integer", "minimum": 0}, "paths": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}}}}},
        "semanticDigest": {"$ref": "#/$defs/Hash"}
      }
    }
  }
}
