{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "guards",
        "proof"
      ],
      "properties": {
        "value": {
          "allOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "not": {
                "properties": {
                  "kind": {
                    "const": "unknown"
                  }
                }
              }
            }
          ]
        },
        "guards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Guard"
          },
          "uniqueItems": true
        },
        "proof": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "uniqueItems": true
        }
      }
    },
    "CandidateDomain": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "candidates",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "finite"
            },
            "candidates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Candidate"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "reason": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "candidates",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "candidates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Candidate"
              },
              "maxItems": 0
            },
            "reason": {
              "$ref": "#/$defs/Id"
            }
          }
        }
      ]
    },
    "EvaluatedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "domain"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "domain": {
          "$ref": "#/$defs/CandidateDomain"
        }
      }
    },
    "EvaluatedBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "state",
        "proof"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "state": {
          "enum": [
            "reachable",
            "unreachable",
            "pending"
          ]
        },
        "proof": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "uniqueItems": true
        }
      }
    },
    "LocalCallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "arguments",
        "guards"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CandidateDomain"
          }
        },
        "guards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Guard"
          },
          "uniqueItems": true
        }
      }
    },
    "LocalEvaluationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "analysis_version",
        "policy_id",
        "scope_id",
        "context_id",
        "function",
        "invocation_id",
        "invocations",
        "origins",
        "arguments",
        "adoptions",
        "dependencies",
        "local_dependencies",
        "budgets",
        "call_bindings"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "LocalEvaluationRequest"
        },
        "analysis_version": {
          "const": "0.1.0"
        },
        "policy_id": {
          "const": "scoped-effects-v1"
        },
        "scope_id": {
          "$ref": "#/$defs/Hash"
        },
        "context_id": {
          "$ref": "#/$defs/Id"
        },
        "function": {
          "$ref": "#/$defs/SourceRef"
        },
        "invocation_id": {
          "$ref": "#/$defs/Id"
        },
        "invocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Invocation"
          },
          "minItems": 1
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Origin"
          },
          "minItems": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CandidateDomain"
          }
        },
        "adoptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Adoption"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          }
        },
        "local_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalDependency"
          },
          "minItems": 1
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "call_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "context_id"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/SourceRef"
              },
              "context_id": {
                "$ref": "#/$defs/Id"
              }
            }
          }
        }
      }
    },
    "LocalEvaluationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "analysis_version",
        "policy_id",
        "request",
        "request_hash",
        "scope_id",
        "context_id",
        "budgets",
        "values",
        "blocks",
        "call_requests",
        "effects",
        "order",
        "returns",
        "escape",
        "resolutions",
        "frontier",
        "diagnostics",
        "status",
        "steps"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "LocalEvaluationResult"
        },
        "analysis_version": {
          "const": "0.1.0"
        },
        "policy_id": {
          "const": "scoped-effects-v1"
        },
        "request": {
          "$ref": "#/$defs/LocalEvaluationRequest"
        },
        "request_hash": {
          "$ref": "#/$defs/Hash"
        },
        "scope_id": {
          "$ref": "#/$defs/Hash"
        },
        "context_id": {
          "$ref": "#/$defs/Id"
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvaluatedValue"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvaluatedBlock"
          }
        },
        "call_requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalCallRequest"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Effect"
          }
        },
        "order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrderEdge"
          }
        },
        "returns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Return"
          }
        },
        "escape": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Value"
          }
        },
        "resolutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resolution"
          }
        },
        "frontier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Id": {
      "type": "string",
      "minLength": 1
    },
    "NullableId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "Status": {
      "enum": [
        "complete",
        "partial",
        "failed",
        "not_run"
      ]
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_key",
        "function_id",
        "id"
      ],
      "properties": {
        "artifact_key": {
          "$ref": "#/$defs/Hash"
        },
        "function_id": {
          "$ref": "#/$defs/NullableId"
        },
        "id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail",
        "source",
        "context_id"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Id"
        },
        "detail": {
          "type": "string"
        },
        "source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/SourceRef"
            }
          ]
        },
        "context_id": {
          "$ref": "#/$defs/NullableId"
        }
      }
    },
    "Budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_steps",
        "condition_states",
        "value_candidates",
        "contexts_per_function",
        "contexts_per_request",
        "scc_iterations",
        "effect_items",
        "worker_seconds",
        "worker_output_bytes",
        "request_seconds",
        "request_output_bytes"
      ],
      "properties": {
        "local_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "condition_states": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "value_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "contexts_per_function": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "contexts_per_request": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "scc_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "effect_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "worker_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "worker_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "request_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "request_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "Allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "cardinality",
        "reason"
      ],
      "properties": {
        "invocation_id": {
          "$ref": "#/$defs/Id"
        },
        "cardinality": {
          "enum": [
            "single",
            "merged",
            "unknown"
          ]
        },
        "reason": {
          "$ref": "#/$defs/NullableId"
        }
      }
    },
    "Invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "context_id",
        "function",
        "parent_id",
        "callsite",
        "cardinality",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "context_id": {
          "$ref": "#/$defs/Id"
        },
        "function": {
          "$ref": "#/$defs/SourceRef"
        },
        "parent_id": {
          "$ref": "#/$defs/NullableId"
        },
        "callsite": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/SourceRef"
            }
          ]
        },
        "cardinality": {
          "enum": [
            "single",
            "merged",
            "unknown"
          ]
        },
        "reason": {
          "$ref": "#/$defs/NullableId"
        }
      }
    },
    "Value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bits",
            "hex"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "bits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            },
            "hex": {
              "type": "string",
              "pattern": "^[0-9A-F]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "offset",
            "address_space",
            "allocation"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "source": {
              "$ref": "#/$defs/SourceRef"
            },
            "offset": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)$"
            },
            "address_space": {
              "type": "integer",
              "minimum": 0
            },
            "allocation": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/Allocation"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "invocation_id"
          ],
          "properties": {
            "kind": {
              "const": "parameter"
            },
            "source": {
              "$ref": "#/$defs/SourceRef"
            },
            "invocation_id": {
              "$ref": "#/$defs/NullableId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "address_space"
          ],
          "properties": {
            "kind": {
              "const": "null"
            },
            "address_space": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "enum": [
                "unknown",
                "poison",
                "undef",
                "freeze"
              ]
            },
            "reason": {
              "$ref": "#/$defs/Id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "operands",
            "invocation_id"
          ],
          "properties": {
            "kind": {
              "const": "expression"
            },
            "source": {
              "$ref": "#/$defs/SourceRef"
            },
            "invocation_id": {
              "$ref": "#/$defs/NullableId"
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Value"
              }
            }
          }
        }
      ]
    },
    "Root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_key",
        "function_id",
        "arguments"
      ],
      "properties": {
        "artifact_key": {
          "$ref": "#/$defs/Hash"
        },
        "function_id": {
          "$ref": "#/$defs/Id"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Value"
          }
        }
      }
    },
    "EffectAnalysisRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "analysis_version",
        "policy_id",
        "scope",
        "mode",
        "roots",
        "budgets"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "EffectAnalysisRequest"
        },
        "analysis_version": {
          "const": "0.1.0"
        },
        "policy_id": {
          "const": "scoped-effects-v1"
        },
        "scope": {
          "$ref": "#/$defs/Id"
        },
        "mode": {
          "enum": [
            "roots",
            "all-defined"
          ]
        },
        "roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Root"
          }
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "roots"
              }
            }
          },
          "then": {
            "properties": {
              "roots": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "roots": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "Origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_key",
        "module_hash",
        "facts_hash",
        "extractor_version",
        "llvm_version",
        "profile"
      ],
      "properties": {
        "artifact_key": {
          "$ref": "#/$defs/Hash"
        },
        "module_hash": {
          "$ref": "#/$defs/Hash"
        },
        "facts_hash": {
          "$ref": "#/$defs/Hash"
        },
        "extractor_version": {
          "const": "0.2.0"
        },
        "llvm_version": {
          "const": "21.1.8"
        },
        "profile": {
          "enum": [
            "source-preserving",
            "build-faithful",
            "imported",
            "linked"
          ]
        }
      }
    },
    "Attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "text",
        "status",
        "reason"
      ],
      "properties": {
        "slot": {
          "type": "integer"
        },
        "text": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "enum": [
            "modeled",
            "conservatively-ignored",
            "unsupported"
          ]
        },
        "reason": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "Interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function_type",
        "return_type",
        "parameter_types",
        "calling_convention",
        "vararg",
        "attributes",
        "status",
        "nounwind",
        "noreturn"
      ],
      "properties": {
        "function_type": {
          "$ref": "#/$defs/Id"
        },
        "return_type": {
          "$ref": "#/$defs/Id"
        },
        "parameter_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "calling_convention": {
          "type": "integer",
          "minimum": 0
        },
        "vararg": {
          "type": "boolean"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attribute"
          }
        },
        "status": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "nounwind": {
          "type": "boolean"
        },
        "noreturn": {
          "type": "boolean"
        }
      }
    },
    "Function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "linkage",
        "visibility",
        "dso_local",
        "declaration",
        "interposable",
        "exact_definition",
        "comdat",
        "selection",
        "interface",
        "body_fingerprint"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "linkage": {
          "$ref": "#/$defs/Id"
        },
        "visibility": {
          "$ref": "#/$defs/Id"
        },
        "dso_local": {
          "type": "boolean"
        },
        "declaration": {
          "type": "boolean"
        },
        "interposable": {
          "type": "boolean"
        },
        "exact_definition": {
          "type": "boolean"
        },
        "comdat": {
          "$ref": "#/$defs/NullableId"
        },
        "selection": {
          "$ref": "#/$defs/NullableId"
        },
        "interface": {
          "$ref": "#/$defs/Interface"
        },
        "body_fingerprint": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Hash"
            }
          ]
        }
      }
    },
    "LocalObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "allocated_type",
        "size_bytes",
        "address_space",
        "private",
        "reason"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "allocated_type": {
          "$ref": "#/$defs/Id"
        },
        "size_bytes": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "address_space": {
          "type": "integer",
          "minimum": 0
        },
        "private": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/NullableId"
        }
      }
    },
    "CallInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "interface",
        "target",
        "tail",
        "bundles"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "interface": {
          "$ref": "#/$defs/Interface"
        },
        "target": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/SourceRef"
            }
          ]
        },
        "tail": {
          "$ref": "#/$defs/Id"
        },
        "bundles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      }
    },
    "Resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
