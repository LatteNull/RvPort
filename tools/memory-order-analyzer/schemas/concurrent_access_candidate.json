{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "NonEmpty": {"type": "string", "minLength": 1},
    "Status": {"enum": ["complete", "partial", "failed"]},
    "Dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": {"$ref": "#/$defs/NonEmpty"},
        "id": {"$ref": "#/$defs/NonEmpty"},
        "digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "EvidenceInput": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "digest", "path", "schema_version", "producer"],
      "properties": {
        "kind": {"$ref": "#/$defs/NonEmpty"},
        "id": {"$ref": "#/$defs/NonEmpty"},
        "digest": {"$ref": "#/$defs/Digest"},
        "path": {"$ref": "#/$defs/NonEmpty"},
        "schema_version": {"type": "integer", "minimum": 1},
        "producer": {"$ref": "#/$defs/NonEmpty"}
      }
    },
    "Diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "detail", "detail_en", "limitation", "limitation_en", "suggestion", "suggestion_en", "source"],
      "properties": {
        "code": {"$ref": "#/$defs/NonEmpty"},
        "detail": {"$ref": "#/$defs/NonEmpty"},
        "detail_en": {"$ref": "#/$defs/NonEmpty"},
        "limitation": {"$ref": "#/$defs/NonEmpty"},
        "limitation_en": {"$ref": "#/$defs/NonEmpty"},
        "suggestion": {"type": ["string", "null"]},
        "suggestion_en": {"type": ["string", "null"]},
        "source": {"type": ["object", "null"]}
      }
    },
    "Budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["translation_units", "roots", "contexts", "effects", "accesses", "instances", "object_candidates", "buckets", "alias_comparisons", "mhp_queries", "candidate_pairs", "exclusions", "protection_queries", "frontier_items", "recursive_iterations", "scc_iterations", "diagnostic_bytes", "worker_seconds", "request_seconds", "request_output_bytes"],
      "properties": {
        "translation_units": {"type": "integer", "minimum": 1, "maximum": 4096},
        "roots": {"type": "integer", "minimum": 1, "maximum": 65536},
        "contexts": {"type": "integer", "minimum": 1, "maximum": 262144},
        "effects": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "accesses": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "instances": {"type": "integer", "minimum": 1, "maximum": 262144},
        "object_candidates": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "buckets": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "alias_comparisons": {"type": "integer", "minimum": 1, "maximum": 4000000},
        "mhp_queries": {"type": "integer", "minimum": 1, "maximum": 4000000},
        "candidate_pairs": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "exclusions": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "protection_queries": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "frontier_items": {"type": "integer", "minimum": 1, "maximum": 262144},
        "recursive_iterations": {"type": "integer", "minimum": 1, "maximum": 64},
        "scc_iterations": {"type": "integer", "minimum": 1, "maximum": 64},
        "diagnostic_bytes": {"type": "integer", "minimum": 128, "maximum": 4096},
        "worker_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "request_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "request_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 268435456}
      }
    },
    "Member": {
      "type": "object", "additionalProperties": false,
      "required": ["physical_tu_id", "profile_id", "language", "standard", "source_digest", "bc_digest", "source_ir_binding_digest"],
      "properties": {
        "physical_tu_id": {"$ref": "#/$defs/NonEmpty"},
        "profile_id": {"$ref": "#/$defs/Digest"},
        "language": {"enum": ["c", "c++"]},
        "standard": {"enum": ["compiler-default", "c89", "c99", "c11", "c17", "c23", "c++98", "c++03", "c++11", "c++14", "c++17", "c++20", "c++23"]},
        "source_digest": {"anyOf": [{"$ref": "#/$defs/Digest"}, {"type": "null"}]},
        "bc_digest": {"anyOf": [{"$ref": "#/$defs/Digest"}, {"type": "null"}]},
        "source_ir_binding_digest": {"anyOf": [{"$ref": "#/$defs/Digest"}, {"type": "null"}]}
      }
    },
    "Base": {
      "type": "object",
      "required": ["schema_version", "kind", "analysis_version", "policy_id"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"$ref": "#/$defs/NonEmpty"},
        "analysis_version": {"const": "0.1.0"},
        "policy_id": {"const": "concurrent-access-candidate-graph-v1"}
      }
    },
    "CommonOutput": {
      "type": "object",
      "required": ["scope_id", "request_hash", "status", "counts", "dependencies", "diagnostics", "frontier", "semantic_digest"],
      "properties": {
        "scope_id": {"$ref": "#/$defs/NonEmpty"},
        "request_hash": {"$ref": "#/$defs/Digest"},
        "status": {"$ref": "#/$defs/Status"},
        "counts": {"type": "object", "additionalProperties": {"type": ["integer", "number", "null"]}},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/Dependency"}},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/Diagnostic"}},
        "frontier": {"type": "array", "items": {"$ref": "#/$defs/Diagnostic"}},
        "semantic_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "ConcurrentAccessCandidateRequest": {
      "allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "additionalProperties": false,
        "required": ["schema_version", "kind", "analysis_version", "policy_id", "scope_id", "closed_scope", "target", "data_layout", "abi", "members", "evidence", "budgets", "semantic_digest"],
        "properties": {
          "schema_version": {}, "kind": {"const": "ConcurrentAccessCandidateRequest"}, "analysis_version": {}, "policy_id": {},
          "scope_id": {"$ref": "#/$defs/NonEmpty"}, "closed_scope": {"type": "boolean"},
          "target": {"$ref": "#/$defs/NonEmpty"}, "data_layout": {"$ref": "#/$defs/NonEmpty"}, "abi": {"$ref": "#/$defs/NonEmpty"},
          "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Member"}},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/EvidenceInput"}},
          "budgets": {"$ref": "#/$defs/Budgets"}, "semantic_digest": {"$ref": "#/$defs/Digest"}
        }
      }]
    },
    "ConcurrentAccessProjectionFacts": {
      "allOf": [{"$ref": "#/$defs/Base"}, {"$ref": "#/$defs/CommonOutput"}, {"type": "object", "additionalProperties": false,
        "required": ["schema_version", "kind", "analysis_version", "policy_id", "scope_id", "request_hash", "status", "accesses", "observed_not_demanded", "counts", "dependencies", "diagnostics", "frontier", "semantic_digest"],
        "properties": {"schema_version": {}, "kind": {"const": "ConcurrentAccessProjectionFacts"}, "analysis_version": {}, "policy_id": {}, "scope_id": {}, "request_hash": {}, "status": {}, "accesses": {"type": "array", "items": {"type": "object"}}, "observed_not_demanded": {"type": "array", "items": {"type": "object"}}, "counts": {}, "dependencies": {}, "diagnostics": {}, "frontier": {}, "semantic_digest": {}}
      }]
    },
    "ExecutionInstanceBindingOverlay": {
      "allOf": [{"$ref": "#/$defs/Base"}, {"$ref": "#/$defs/CommonOutput"}, {"type": "object", "additionalProperties": false,
        "required": ["schema_version", "kind", "analysis_version", "policy_id", "scope_id", "request_hash", "status", "roots", "contexts", "instances", "invocations", "mhp", "exclusions", "counts", "dependencies", "diagnostics", "frontier", "semantic_digest"],
        "properties": {"schema_version": {}, "kind": {"const": "ExecutionInstanceBindingOverlay"}, "analysis_version": {}, "policy_id": {}, "scope_id": {}, "request_hash": {}, "status": {}, "roots": {"type": "array", "items": {"type": "object"}}, "contexts": {"type": "array", "items": {"type": "object"}}, "instances": {"type": "array", "items": {"type": "object"}}, "invocations": {"type": "array", "items": {"type": "object"}}, "mhp": {"type": "array", "items": {"type": "object"}}, "exclusions": {"type": "array", "items": {"type": "object"}}, "counts": {}, "dependencies": {}, "diagnostics": {}, "frontier": {}, "semantic_digest": {}}
      }]
    },
    "AccessProtectionOverlay": {
      "allOf": [{"$ref": "#/$defs/Base"}, {"$ref": "#/$defs/CommonOutput"}, {"type": "object", "additionalProperties": false,
        "required": ["schema_version", "kind", "analysis_version", "policy_id", "scope_id", "request_hash", "status", "protections", "counts", "dependencies", "diagnostics", "frontier", "semantic_digest"],
        "properties": {"schema_version": {}, "kind": {"const": "AccessProtectionOverlay"}, "analysis_version": {}, "policy_id": {}, "scope_id": {}, "request_hash": {}, "status": {}, "protections": {"type": "array", "items": {"type": "object"}}, "counts": {}, "dependencies": {}, "diagnostics": {}, "frontier": {}, "semantic_digest": {}}
      }]
    },
    "ConcurrentAccessCandidateGraph": {
      "allOf": [{"$ref": "#/$defs/Base"}, {"$ref": "#/$defs/CommonOutput"}, {"type": "object", "additionalProperties": false,
        "required": ["schema_version", "kind", "analysis_version", "policy_id", "scope_id", "request_hash", "status", "projection", "execution_instances", "protection", "accesses", "candidates", "exclusions", "atomic_handoff", "completeness", "counts", "dependencies", "diagnostics", "frontier", "semantic_digest"],
        "properties": {"schema_version": {}, "kind": {"const": "ConcurrentAccessCandidateGraph"}, "analysis_version": {}, "policy_id": {}, "scope_id": {}, "request_hash": {}, "status": {}, "projection": {"$ref": "#/$defs/Dependency"}, "execution_instances": {"$ref": "#/$defs/Dependency"}, "protection": {"$ref": "#/$defs/Dependency"}, "accesses": {"type": "array", "items": {"type": "object"}}, "candidates": {"type": "array", "items": {"type": "object"}}, "exclusions": {"type": "array", "items": {"type": "object"}}, "atomic_handoff": {"type": "array", "items": {"type": "object"}}, "completeness": {"type": "object"}, "counts": {}, "dependencies": {}, "diagnostics": {}, "frontier": {}, "semantic_digest": {}}
      }]
    },
    "ConcurrentAccessCandidateReport": {
      "allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "additionalProperties": false,
        "required": ["schema_version", "kind", "analysis_version", "policy_id", "scope_id", "request_hash", "status", "exit_code", "safety", "findings", "graph", "language_counts", "completeness", "counts", "dependencies", "diagnostics", "frontier", "cache", "semantic_digest"],
        "properties": {"schema_version": {}, "kind": {"const": "ConcurrentAccessCandidateReport"}, "analysis_version": {}, "policy_id": {}, "scope_id": {"type": ["string", "null"]}, "request_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "status": {"$ref": "#/$defs/Status"}, "exit_code": {"enum": [0, 1, 2]}, "safety": {"const": "not_evaluated"}, "findings": {"type": "null"}, "graph": {"anyOf": [{"$ref": "#/$defs/Dependency"}, {"type": "null"}]}, "language_counts": {"type": "object"}, "completeness": {"type": "object"}, "counts": {"type": "object"}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/Dependency"}}, "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/Diagnostic"}}, "frontier": {"type": "array", "items": {"$ref": "#/$defs/Diagnostic"}}, "cache": {"type": "object", "additionalProperties": false, "required": ["hits", "misses"], "properties": {"hits": {"type": "integer", "minimum": 0}, "misses": {"type": "integer", "minimum": 0}}}, "semantic_digest": {"$ref": "#/$defs/Digest"}}
      }]
    }
  }
}
