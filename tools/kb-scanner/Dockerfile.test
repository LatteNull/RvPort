ARG UBUNTU_IMAGE=ubuntu:noble
FROM ${UBUNTU_IMAGE} AS scanner-deps

ARG LLVM_PACKAGE_VERSION=1:18.1.3-1ubuntu1
ARG DEBIAN_FRONTEND=noninteractive
ENV VIRTUAL_ENV=/opt/kb-scanner-venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

COPY tools/kb-scanner/requirements/runtime.lock /opt/kb-scanner/requirements/runtime.lock

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang-18=${LLVM_PACKAGE_VERSION} \
        libclang-18-dev=${LLVM_PACKAGE_VERSION} \
        python3 \
        python3-dev \
        python3-clang-18=${LLVM_PACKAGE_VERSION} \
        python3-venv \
    && python3 -m venv --system-site-packages "${VIRTUAL_ENV}" \
    && CC=clang-18 python -m pip install --no-cache-dir --requirement /opt/kb-scanner/requirements/runtime.lock \
    && rm -rf /var/lib/apt/lists/*

FROM scanner-deps AS kb-scanner-test

WORKDIR /workspace/tools/kb-scanner

COPY tools/kb-scanner/requirements/test.lock /opt/kb-scanner/requirements/test.lock
RUN python -m pip install --no-cache-dir --requirement /opt/kb-scanner/requirements/test.lock

COPY tools/kb-scanner /workspace/tools/kb-scanner

ENV PYTHONPATH=/workspace/tools/kb-scanner
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python"]
CMD ["tests/run_container_tests.py"]
