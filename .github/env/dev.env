# RvPort Dev 部署环境变量（由 Gitea 平台 .gitea/env/dev.env 迁移而来）
# COMPOSE_PROJECT_NAME 会作为 namespace 隔离 dev/test 的容器、网络、卷
COMPOSE_PROJECT_NAME=ryport-dev

# ---- MinIO 镜像（GitHub 环境无法访问 Harbor 内网，改用官方公网镜像，版本与备份一致）----
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z

# ---- 端口（使用默认端口，服务器上这些端口均空闲）----
FRONTEND_PORT=8081
RVPORT_BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- 数据库 ----
POSTGRES_DB=ryport_dev
POSTGRES_USER=ryport_dev
POSTGRES_PASSWORD=ryport_dev_pwd_2026

# ---- Redis ----
REDIS_PASSWORD=ryport_dev_redis_2026

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=ryport_dev
RABBITMQ_DEFAULT_PASS=ryport_dev_mq_2026
RABBITMQ_DEFAULT_VHOST=ryport_dev

# ---- MinIO ----
MINIO_ROOT_USER=ryport_dev
MINIO_ROOT_PASSWORD=ryport_dev_minio_2026
RVPORT_OBJECT_STORAGE_ENABLED=true
RVPORT_OBJECT_STORAGE_ENDPOINT=http://minio:9000
RVPORT_OBJECT_STORAGE_REGION=us-east-1
RVPORT_OBJECT_STORAGE_BUCKET=rvport-artifacts
RVPORT_OBJECT_STORAGE_ACCESS_KEY=ryport_dev
RVPORT_OBJECT_STORAGE_SECRET_KEY=ryport_dev_minio_2026
RVPORT_OBJECT_STORAGE_PATH_STYLE=true
RVPORT_OBJECT_STORAGE_AUTO_CREATE_BUCKET=true

# ---- 加密密钥（base64 编码的 32 字节密钥；沿用原值，保证服务器已有数据可解密）----
RVPORT_CREDENTIAL_MASTER_KEY=1f3/v10XhtHBL2+yNo2DuqwzVPx3Kc4qrMyNg6FDcAM=
RVPORT_CREDENTIAL_KEY_ID=local-v1

# ---- Worker ----
RVPORT_WORKER_CONCURRENCY_LIMIT=2
RVPORT_WORKER_MAX_CONCURRENCY_LIMIT=8
