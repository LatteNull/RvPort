# RvPort Test 部署环境变量（由 Gitea 平台 .gitea/env/test.env 迁移而来）
# COMPOSE_PROJECT_NAME 会作为 namespace 隔离 dev/test 的容器、网络、卷
COMPOSE_PROJECT_NAME=ryport-test

# ---- MinIO 镜像（GitHub 环境无法访问 Harbor 内网，改用官方公网镜像，版本与备份一致）----
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z

# ---- 端口（与 dev 错开，避免冲突）----
FRONTEND_PORT=18081
RVPORT_BACKEND_PORT=18080
POSTGRES_PORT=15432
REDIS_PORT=16379
RABBITMQ_AMQP_PORT=15673
RABBITMQ_MANAGEMENT_PORT=25672
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# ---- 数据库 ----
POSTGRES_DB=ryport_test
POSTGRES_USER=ryport_test
POSTGRES_PASSWORD=ryport_test_pwd_2026

# ---- Redis ----
REDIS_PASSWORD=ryport_test_redis_2026

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=ryport_test
RABBITMQ_DEFAULT_PASS=ryport_test_mq_2026
RABBITMQ_DEFAULT_VHOST=ryport_test

# ---- MinIO ----
MINIO_ROOT_USER=ryport_test
MINIO_ROOT_PASSWORD=ryport_test_minio_2026
RVPORT_OBJECT_STORAGE_ENABLED=true
RVPORT_OBJECT_STORAGE_ENDPOINT=http://minio:9000
RVPORT_OBJECT_STORAGE_REGION=us-east-1
RVPORT_OBJECT_STORAGE_BUCKET=rvport-artifacts
RVPORT_OBJECT_STORAGE_ACCESS_KEY=ryport_test
RVPORT_OBJECT_STORAGE_SECRET_KEY=ryport_test_minio_2026
RVPORT_OBJECT_STORAGE_PATH_STYLE=true
RVPORT_OBJECT_STORAGE_AUTO_CREATE_BUCKET=true

# ---- 加密密钥（base64 编码的 32 字节密钥；沿用原值，保证服务器已有数据可解密）----
RVPORT_CREDENTIAL_MASTER_KEY=pqgpcHX3Jf6Tn6I61+E7MAUESgGbgmFFHBc+DqWMptc=
RVPORT_CREDENTIAL_KEY_ID=local-v1

# ---- Worker ----
RVPORT_WORKER_CONCURRENCY_LIMIT=2
RVPORT_WORKER_MAX_CONCURRENCY_LIMIT=8
