# 复制为 .env 后填写本地配置；凭据主密钥须自行生成，见 docs/安装指南.md。
COMPOSE_PROJECT_NAME=rvport

POSTGRES_IMAGE=postgres:18.4
POSTGRES_DB=rvport
POSTGRES_USER=rvport
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

RABBITMQ_IMAGE=rabbitmq:4.3.2-management
RABBITMQ_DEFAULT_USER=rvport
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_DEFAULT_VHOST=rvport
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_IMAGE=redis:8.8.0
REDIS_PASSWORD=change_me
REDIS_PORT=6379

MINIO_IMAGE=rvport-minio:local
MINIO_ROOT_USER=rvport
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=rvport-artifacts

FRONTEND_PORT=8081
RVPORT_BACKEND_PORT=8080
RVPORT_DB_URL=jdbc:postgresql://localhost:5432/rvport
RVPORT_DB_USER=rvport
RVPORT_DB_PASSWORD=change_me
RVPORT_REDIS_HOST=localhost
RVPORT_REDIS_PORT=6379
RVPORT_REDIS_PASSWORD=change_me
RVPORT_RABBITMQ_HOST=localhost
RVPORT_RABBITMQ_PORT=5672
RVPORT_RABBITMQ_USERNAME=rvport
RVPORT_RABBITMQ_PASSWORD=change_me
RVPORT_RABBITMQ_VHOST=rvport
RVPORT_OBJECT_STORAGE_ENABLED=true
RVPORT_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
RVPORT_OBJECT_STORAGE_REGION=us-east-1
RVPORT_OBJECT_STORAGE_BUCKET=rvport-artifacts
RVPORT_OBJECT_STORAGE_ACCESS_KEY=rvport
RVPORT_OBJECT_STORAGE_SECRET_KEY=change_me_minio
RVPORT_OBJECT_STORAGE_PATH_STYLE=true
RVPORT_OBJECT_STORAGE_AUTO_CREATE_BUCKET=true

# 凭据加密主密钥：必须为 base64 编码后的 32 字节（编码后为 44 个字符）。
# 生成方式：docker run --rm python:3.12-slim python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# 留空或长度不足 32 字节时，保存项目凭据会因加密初始化失败而报错。
RVPORT_CREDENTIAL_MASTER_KEY=
RVPORT_CREDENTIAL_KEY_ID=local-v1

RVPORT_LOG_DIR=./backend/runtime/logs
RVPORT_ARCHIVE_DIR=./backend/runtime/archives
RVPORT_UPLOAD_DIR=./backend/runtime/uploads

RVPORT_SOURCE_DIR=./backend/runtime/sources

NODE_VERSION=22.23.2
NODE_DISTRO=linux-x64
NODEJS_MIRROR=https://npmmirror.com/mirrors/node
NPM_REGISTRY=https://registry.npmmirror.com
CODEX_CLI_VERSION=0.147.0
DEEPSEEK_HARNESS_VERSION=0.1.0-rc.7
OPENCODE_VERSION=1.18.18
LLVM_PACKAGE_VERSION=1:18.1.3-1ubuntu1
RVPORT_AGENT_CODEX_EXECUTABLE=codex
RVPORT_AGENT_DEEPSEEK_HARNESS_EXECUTABLE=dsh
RVPORT_AGENT_OPENCODE_EXECUTABLE=opencode
RVPORT_KB_SCAN_PYTHON_COMMAND=/opt/kb-scanner-venv/bin/python
RVPORT_SPECIALIZED_ANALYSIS_ENABLED=true
RVPORT_SPECIALIZED_ANALYSIS_TIMEOUT_SECONDS=3600
RVPORT_SPECIALIZED_ANALYSIS_MAX_OUTPUT_BYTES=268435456
RVPORT_SPECIALIZED_ANALYSIS_MAX_EXTRACTED_BYTES=1073741824
RVPORT_SPECIALIZED_ANALYSIS_MAX_FILES=200000
RVPORT_FLOATING_POINT_PYTHON=/opt/specialized-analysis-venv/bin/python
RVPORT_FLOATING_POINT_SCANNER=/opt/specialized-analysis-venv/bin/fp-precision-scanner
RVPORT_FLOATING_POINT_CLANG=/usr/bin/clang-21
RVPORT_FLOATING_POINT_IR_WORKER=/opt/rvport/analysis-tools/bin/fp-ir-worker
RVPORT_MEMORY_ORDER_PYTHON=/opt/specialized-analysis-venv/bin/python
RVPORT_MEMORY_ORDER_IR_WORKER=/opt/rvport/analysis-tools/bin/moa-worker
RVPORT_MEMORY_ORDER_SOURCE_WORKER=/opt/rvport/analysis-tools/bin/memory-order-source-worker

RVPORT_WORKER_INSTANCE_ID=
RVPORT_WORKER_CONCURRENCY_LIMIT=1
RVPORT_WORKER_MAX_CONCURRENCY_LIMIT=8
RVPORT_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
RVPORT_WORKER_OFFLINE_TIMEOUT_SECONDS=60
RVPORT_WORKER_CLEANUP_ENABLED=true
RVPORT_WORKER_CLEANUP_INTERVAL_MS=300000
RVPORT_WORKER_CLEANUP_LOST_TIMEOUT_SECONDS=300
RVPORT_WORKER_CLEANUP_RETENTION_HOURS=24
RVPORT_WORKER_CLEANUP_BATCH_SIZE=100
