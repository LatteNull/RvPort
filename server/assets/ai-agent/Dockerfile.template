# 0 拉取基础ubuntu镜像
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG CROSS_COMPILER
ARG APT_URI
# 1 配置apt源
RUN echo "Types: deb" > /etc/apt/sources.list.d/ubuntu.sources \
    && echo "URIs: ${APT_URI}" >> /etc/apt/sources.list.d/ubuntu.sources \
    && echo "Suites: noble noble-updates noble-backports" >> /etc/apt/sources.list.d/ubuntu.sources \
    && echo "Components: main universe restricted multiverse" >> /etc/apt/sources.list.d/ubuntu.sources \
    && echo "Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg" >> /etc/apt/sources.list.d/ubuntu.sources
# 2 拷贝qemu-user模拟器
ADD qemu_linux.txz /usr/local/bin/
# 3 设置工作目录 /app
WORKDIR /app/
# 4 apt-get安装必要的程序
RUN CROSS_PKGS=$(echo "$CROSS_COMPILER" | tr ',' ' ') && \
    apt-get update && apt-get install -y git gcc g++ tmux nasm asciinema python3 xz-utils curl fd-find ripgrep cmake $CROSS_PKGS
# 5 安装nodejs
COPY node.tar.xz /app/
RUN tar -xf /app/node.tar.xz -C /usr/local  --strip-components=1 && \
    rm -f /app/node.tar.xz
# 6 安装pi cli及其相关配置
# PIP_INDEX / NPM_REGISTRY 可通过 --build-arg 覆盖（内网镜像源），默认公网官方源
ARG PIP_INDEX=https://pypi.org/simple
ARG NPM_REGISTRY=https://registry.npmjs.org/
RUN rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED
COPY offline /tmp/offline
RUN python3 /tmp/offline/get-pip.py --no-index --find-links=/tmp/offline && \
    OLD_PIP_INDEX=$(pip3 config list | grep 'global.index-url' | cut -d'=' -f2 2>/dev/null || echo "")  && \
    pip3 config set global.index-url ${PIP_INDEX} && \
    # ★ fastmcp 钉上界 <4：riscv_doc_mcp 0.2.0 声明 fastmcp>=2.14.3（无上界），
    #   不钉的话 pip 在线解析装"构建当天最新版"——fastmcp 4.0（2026-08-31 发布）
    #   删除了 fastmcp.server.proxy 模块（移到 server.providers.proxy），
    #   riscv_doc_mcp 第 2 行 import 即 ModuleNotFoundError，MCP server 起不来，
    #   pi 报 "Failed to reconnect to riscv-doc-mcp"。
    #   2.14.3+~3.4.7 均含 server.proxy.ProxyClient（已逐版本核实）。
    #   将来升 fastmcp 4.x 时需同步改 riscv_doc_mcp 的 import 路径。
    pip install /tmp/offline/riscv_doc_mcp-0.2.0-py3-none-any.whl "fastmcp>=2.14.3,<4" && \
    # 安装后手动升级固定版本，消除 setuptools/wheel 漏洞版本（离线安装，不入镜像源配置）
    pip install --no-index --find-links=/tmp/offline setuptools==84.0.0 wheel==0.48.0 && \
    if [ -n "$OLD_PIP_INDEX" ]; then pip3 config set global.index-url "$OLD_PIP_INDEX"; else pip3 config unset global.index-url; fi && \
    python3 -m pip uninstall pip -y && rm -rf /root/.cache/pip && rm -rf /tmp/offline
RUN OLD_NPM_REGISTRY=$(npm config get registry 2>/dev/null || echo "") && \
    npm config set registry https://artxa.zte.com.cn/artifactory/api/npm/public-npm-virtual/ && \
    # node 内嵌 npm 较旧，前置升级固定版本，同步消除内嵌 tar/minimatch/glob/brace-expansion/ip-address 漏洞版本
    npm install -g npm@11.19.0 && \
    npm install -g --ignore-scripts @earendil-works/pi-coding-agent && \
    pi install npm:pi-mcp-adapter && \
    pi install npm:pi-subagents && \
    if [ -n "$OLD_NPM_REGISTRY" ]; then npm config set registry "$OLD_NPM_REGISTRY"; else npm config delete registry; fi
COPY pipi /tmp/pipi
RUN cd /tmp/pipi && \
    chmod +x pipi && \
    mkdir -p ~/.local/bin && \
    mv pipi ~/.local/bin/pipi && \
    mkdir -p ~/.pi/agent/extensions && \
    mv url-provider.ts ~/.pi/agent/extensions/url-provider.ts && rm -rf /tmp/pipi
# 7 在pi中配置mcp server 
ADD .pi /root/.pi
# 8 安装cursor cli以及配置环境变量
ADD cursor_cli.tar /root/
ENV PATH="/root/.local/bin:${PATH}"
ADD .cursor /root/.cursor
ENV NODE_USE_ENV_PROXY=1


# 配置git safe.directory，避免非root用户操作/app时触发dubious ownership报错
RUN git config --global --add safe.directory /app